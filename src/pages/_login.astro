---
import Layout from '../layouts/Layout.astro';
import LoginForm from '../components/auth/LoginForm.tsx';
---

<Layout title="Iniciar sesión | Vanidiosas by Gonsa">
  <section class="bg-bone">
    <div class="mx-auto max-w-[480px] px-8 py-16">
      <h1 class="font-display text-4xl font-medium md:text-5xl">Iniciar sesión</h1>
      <div class="mb-8 mt-3.5 h-[3px] w-16 bg-sun"></div>

      <!-- React island: only the form ships JavaScript -->
      <LoginForm client:load />

      <p class="mt-8 text-sm text-muted">
        ¿No tienes cuenta? <a href="/Register" class="text-ink underline">Crea una</a>
      </p>
    </div>
  </section>
</Layout>