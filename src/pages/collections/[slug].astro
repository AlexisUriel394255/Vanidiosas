---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/product/ProductCard.astro';
import products from '../../data/products.json';
import { collections } from '../../data/collections';

export function getStaticPaths() {
  return collections.map((collection) => ({
    params: { slug: collection.slug },
  }));
}

const collection = collections.find((item) => item.slug === Astro.params.slug);
const items = collection ? products.filter(collection.filter) : [];
const countLabel = `${items.length} ${items.length === 1 ? 'modelo' : 'modelos'}`;
---

<Layout title={`${collection?.title} | Vanidiosas by Gonsa`}>
  <section class="bg-bone">
    <div class="mx-auto max-w-[1240px] px-8 py-16">

      <nav aria-label="Breadcrumb" class="mb-8 text-[13px] text-muted">
        <a href="/" class="hover:text-ink">Inicio</a>
        <span class="mx-2">/</span>
        <span class="text-ink">{collection?.title}</span>
      </nav>

      <h1 class="font-display text-4xl font-medium md:text-5xl">{collection?.title}</h1>
      <div class="mb-4 mt-3.5 h-[3px] w-16 bg-sun"></div>
      <p class="mb-10 text-sm text-muted">{countLabel}</p>

      {items.length === 0 ? (
        <p class="text-muted">Pronto tendremos nuevos modelos en esta colección.</p>
      ) : (
        <ul class="grid grid-cols-2 gap-7 lg:grid-cols-4">
          {items.map((product) => (
            <li>
              <ProductCard product={product} />
            </li>
          ))}
        </ul>
      )}

    </div>
  </section>
</Layout>
