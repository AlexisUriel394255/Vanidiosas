---
const collections = [
  { name: 'Sandalias', href: '/collections/sandals', image: '/images/products/6077-perlas-buck-negro-1.webp' },
  { name: 'Zapatillas', href: '/collections/shoes', image: '/images/products/6077-snake-cabra-metal-oro-2.webp' },
  { name: 'Balerinas', href: '/collections/flats', image: '/images/products/6077-perlas-cabra-maquillaje-1.webp' },
  { name: 'Lo más nuevo', href: '/collections/new-arrivals', image: '/images/products/6077-snake-buck-negro-1.webp', featured: true },
];
---
<section class="bg-white">
  <div class="mx-auto max-w-[1240px] px-8 py-20">
    <h2 class="font-display text-4xl font-medium md:text-5xl">Nuestras colecciones</h2>
    <div class="mb-10 mt-3.5 h-[3px] w-16 bg-sun"></div>

    <div class="grid grid-cols-2 gap-6 lg:grid-cols-4">
      {collections.map((item) => (
        <a
          href={item.href}
          class={`flex aspect-[3/4] items-end border-b-[3px] border-transparent p-6 transition-colors hover:border-sun ${
            item.featured
              ? 'bg-linear-to-b from-[#FFE680] to-sun'
              : 'bg-linear-to-b from-bone to-[#E6D8B8]'
          }`}
        >
          <span class="font-display text-3xl font-medium text-ink">{item.name}</span>
        </a>
      ))}
    </div>
  </div>
</section>