---
import { collections } from '../../data/collections';
import products from '../../data/products.json';

// Only show collections that have at least one product
const cards = collections
  .map((collection) => {
    const items = products.filter(collection.filter);
    return {
      name: collection.title,
      href: `/collections/${collection.slug}`,
      image: items[0]?.image,
      count: items.length,
      featured: collection.slug === 'nuevo',
    };
  })
  .filter((card) => card.count > 0);
---
<section class="bg-white">
  <div class="mx-auto max-w-[1240px] px-8 py-20">
    <h2 class="font-display text-4xl font-medium md:text-5xl">Nuestras colecciones</h2>
    <div class="mb-10 mt-3.5 h-[3px] w-16 bg-sun"></div>

    <div class="grid grid-cols-2 gap-6 lg:grid-cols-4">
      {cards.map((card) => (
        <a
          href={card.href}
          class={`relative flex aspect-[3/4] items-end overflow-hidden border-b-[3px] border-transparent p-6 transition-colors hover:border-sun ${
            card.featured
              ? 'bg-linear-to-b from-[#FFE680] to-sun'
              : 'bg-linear-to-b from-bone to-[#E6D8B8]'
          }`}
        >
          {card.image && (
            <img
              src={card.image}
              alt=""
              loading="lazy"
              class="absolute inset-0 size-full object-contain p-4 pb-16 mix-blend-multiply"
            />
          )}
          <span class="relative font-display text-3xl font-medium text-ink">{card.name}</span>
        </a>
      ))}
    </div>
  </div>
</section>