---
const columns = [
  {
    title: 'Nuestros productos',
    links: [
      { label: 'Lo más nuevo', href: '/collections/nuevo' },
      { label: 'Sandalias', href: '/collections/sandalias' },
      { label: 'Zapatillas', href: '/collections/zapatillas' },
      { label: 'Balerinas', href: '/collections/balerinas' },
      { label: 'Ver todo', href: '/products' },
    ],
  },
  // The policies column goes here once the client sends the texts
];

// Fill these with the real profile URLs. Empty means the icon is hidden
const facebookUrl = '';
const instagramUrl = '';

const whatsapp = import.meta.env.PUBLIC_WHATSAPP_NUMBER as string | undefined;
const year = new Date().getFullYear();
---
<footer class="border-t-[6px] border-sun bg-linear-to-b from-bone to-[#FFF1B8] text-ink">
  <div class="mx-auto max-w-[1240px] px-8 pb-10 pt-[72px]">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-[1.2fr_1fr_1.1fr]">

      <div>
        <span class="font-display text-4xl font-semibold">Vanidiosas</span>
        <p class="mt-1.5 text-[11px] tracking-[0.38em] text-muted">BY GONSA</p>
      </div>

      {columns.map((column) => (
        <nav aria-label={column.title}>
          <p class="mb-5 inline-block border-b-2 border-sun pb-1.5 text-xs font-medium uppercase tracking-[0.24em]">
            {column.title}
          </p>
          <ul class="space-y-3">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="text-muted transition-colors hover:text-ink">{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}

      <div>
        <p class="mb-5 inline-block border-b-2 border-sun pb-1.5 text-xs font-medium uppercase tracking-[0.24em]">
          ¡Contáctanos!
        </p>
        {whatsapp && (
          <p>
            <a
              href={`https://wa.me/${whatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
              class="border-b border-ink"
            >
              Escríbenos por WhatsApp
            </a>
          </p>
        )}
      </div>
    </div>

    {(facebookUrl || instagramUrl) && (
      <div class="mt-14 flex justify-center gap-3">
        {facebookUrl && (
          <a href={facebookUrl} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="flex size-11 items-center justify-center rounded-full border border-[#D9CBA8] text-ink transition-colors hover:border-sun hover:bg-sun">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 8h2V5h-2.5C11.3 5 10 6.4 10 8.5V10H8v3h2v6h3v-6h2.2l.5-3H13V8.7c0-.5.2-.7 1-.7z" />
            </svg>
          </a>
        )}
        {instagramUrl && (
          <a href={instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="flex size-11 items-center justify-center rounded-full border border-[#D9CBA8] text-ink transition-colors hover:border-sun hover:bg-sun">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="4" y="4" width="16" height="16" rx="5" />
              <circle cx="12" cy="12" r="3.5" />
              <circle cx="17" cy="7" r=".6" />
            </svg>
          </a>
        )}
      </div>
    )}

    <p class="mt-10 border-t border-[#E0D2AE] pt-6 text-center text-[13px] text-muted">
      © {year} Vanidiosas by Gonsa
    </p>
  </div>
</footer>