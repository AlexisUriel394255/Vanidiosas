---
import { Search, User, ShoppingBag } from '@lucide/astro';
const links = [
{ label: 'Sandalias', href: '/coleccion/sandalias'},
{ label: 'Zapatillas', href: '/coleccion/zapatillas'},
{ label: 'Balerinas', href: '/coleccion/balerinas'},
{ label: 'Lo mas vendido', href: '/coleccion/mas-vendido'},
{ label: 'Lo mas nuevo', href: '/coleccion/nuevo'},
{ label: 'Ver todo', href: '/productos'},
];
---



<header class="border-b border-[#E6DCCD] bg-ivory">
<div class="mx-auto flex h-[84px] max-w-[1240px] items-center justify-between px-8">
<a href="/" class="flex flex-col items-center leading-none">
<span class="font-display text-4xl font-semibold tracking-tight">Vanidiosas</span>
<span class="mt-1 text-[10px] tracking-[0.38em] text-muted">BY GONSA</span>
</a>
<nav class="hidden gap-8 text-sm tracking-wide lg:flex" aria-label"Principal">
{links.map((link) =>(
 <a href={link.href} class="transition-colors hover:text-wine">{link.label}</a>
))}
</nav>
<div class="flex gap-1">
  <button aria-label="Buscar" class="flex size-11 items-center justify-center">
    <Search size={22} strokeWidth={1.5} />
  </button>
  <button aria-label="Mi cuenta" class="flex size-11 items-center justify-center">
    <User size={22} strokeWidth={1.5} />
  </button>
  <button aria-label="Carrito" class="flex size-11 items-center justify-center">
    <ShoppingBag size={22} strokeWidth={1.5} />
  </button>
</div>
</div>
</header>