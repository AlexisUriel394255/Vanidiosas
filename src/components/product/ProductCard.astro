---
import { formatPrice } from '../../utils/format';

// Only the fields this card needs. Extra fields in the product are allowed
interface Props {
  product: {
    slug: string;
    name: string;
    price: number;
    image: string;
    rating: number;
    reviewCount: number;
  };
}

const { product } = Astro.props;
---

<a href={`/products/${product.slug}`} class="group block">
  <div class="aspect-[4/5] overflow-hidden border border-b-[3px] border-[#EADFC9] border-b-sun bg-linear-to-b from-white to-[#FFF4CC]">
    <img
      src={product.image}
      alt={product.name}
      loading="lazy"
      class="size-full object-contain mix-blend-multiply transition-transform duration-500 group-hover:scale-105"
    />
  </div>
  <h3 class="mt-4 text-base">{product.name}</h3>
  <p class="mt-1 text-[13px] tracking-widest text-sun-deep">
    {'★'.repeat(product.rating)}
    <span class="tracking-normal text-muted">({product.reviewCount})</span>
  </p>
  <p class="mt-1.5 text-[17px] font-medium">{formatPrice(product.price)}</p>
</a>