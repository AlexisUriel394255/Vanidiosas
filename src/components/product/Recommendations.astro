---
import products from "../../data/products.json";
import { formatPrice } from "../../utils/format";

interface Props {
  currentSlug: string;
  category?: string;
}

const { currentSlug, category } = Astro.props;

// Always show exactly this many recommendations
const MAX_ITEMS = 4;

// Exclude the product the user is already viewing
const others = products.filter((p) => p.slug !== currentSlug);

// Same-category products first, because they are the most relevant
const sameCategory = others.filter((p) => p.category === category);
const rest = others.filter((p) => p.category !== category);

const recommended = [...sameCategory, ...rest].slice(0, MAX_ITEMS);

// Some products have an `images` list, others only a single `image`
const getCover = (p: (typeof products)[number]) => p.images?.[0] ?? p.image;
---

<section class="mt-16" aria-labelledby="rec-title">
  <h2 id="rec-title" class="font-display text-2xl md:text-3xl">
    También te puede gustar
  </h2>
  <div class="mb-8 mt-3 h-[3px] w-16 bg-sun"></div>

  <!-- 2 columns on mobile, 4 columns on desktop -->
  <ul class="grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-6">
    {recommended.map((p) => (
      <li>
        <a href={`/products/${p.slug}`} class="group block">
          <!-- Same look as the "Lo más vendido" cards: gradient + yellow bottom border -->
          <div class="aspect-[4/5] overflow-hidden border-b-2 border-sun bg-linear-to-b from-white to-sun/20">
            <img
              src={getCover(p)}
              alt={p.name}
              loading="lazy"
              class="size-full object-contain p-4 transition duration-300 group-hover:scale-105"
            />
          </div>
          <h3 class="mt-3 text-sm">{p.name}</h3>
          <p class="font-medium">{formatPrice(p.price)}</p>
        </a>
      </li>
    ))}
  </ul>
</section>