---
import reviews from "../../data/reviews.json";

interface Props {
  productSlug: string;
}

const { productSlug } = Astro.props;
const productReviews = reviews.filter((r) => r.productSlug === productSlug);

const average = productReviews.length
  ? productReviews.reduce((sum, r) => sum + r.rating, 0) / productReviews.length
  : 0;
---

<section class="mt-16" aria-labelledby="reviews-title">
  <div class="mb-6 flex flex-wrap items-baseline gap-3">
    <h2 id="reviews-title" class="font-serif text-2xl md:text-3xl">
      Reseñas
    </h2>
    {productReviews.length > 0 && (
      <p class="text-sm">
        <span aria-hidden="true">★</span>
        {average.toFixed(1)} · {productReviews.length}
        {productReviews.length === 1 ? "reseña" : "reseñas"}
      </p>
    )}
  </div>

  {productReviews.length === 0 ? (
    <p class="text-sm opacity-70">Aún no hay reseñas para este modelo.</p>
  ) : (
    <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {productReviews.map((r) => (
        <li class="border border-current/15 bg-white p-5">
          <p class="text-sm" aria-label={`${r.rating} de 5 estrellas`}>
            {"★".repeat(r.rating)}{"☆".repeat(5 - r.rating)}
          </p>
          <h3 class="mt-2 font-serif text-lg">{r.title}</h3>
          <p class="mt-1 text-sm opacity-80">{r.text}</p>
          <p class="mt-3 text-sm font-medium">{r.author}</p>
        </li>
      ))}
    </ul>
  )}
</section>