---
<section class="mt-16 border-t border-stone-200 pt-12 w-full clear-both">
  <h2 class="text-xl md:text-2xl font-serif text-stone-900 font-medium mb-8">También te encantará</h2>
  
  <ul class="flex gap-4 overflow-x-auto snap-x snap-mandatory scrollbar-none pb-4 w-full md:justify-center">
    <!-- Card 1: Tributo Latte -->
    <li class="w-[260px] flex-shrink-0 snap-start flex flex-col gap-2">
      <a href="/tributo-latte" class="block w-full h-full cursor-pointer group">
        <div class="w-full aspect-[4/5] overflow-hidden bg-[#f3f3f3] rounded-xl">
          <img src="/images/4.webp" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" alt="Tributo Latte" />
        </div>
        <h4 class="text-sm text-stone-900 font-medium mt-1 group-hover:underline">Tributo Latte</h4>
        <div class="flex text-[10px] text-amber-400 gap-0.5 items-center">
          <span>★★★★★</span>
          <span class="text-stone-500 text-[11px] ml-1">(3)</span>
        </div>
        <p class="text-base font-semibold text-stone-900 mt-0.5">$ 1,799</p>
      </a>
    </li>

    <!-- Card 2: Tributo Cuero -->
    <li class="w-[260px] flex-shrink-0 snap-start flex flex-col gap-2">
      <a href="/tributo-cuero" class="block w-full h-full cursor-pointer group">
