        </div>
        <p class="text-base font-semibold text-stone-900 mt-0.5">$ 1,799</p>
      </a>
    </li>

    <!-- Card 3: Tributo Camel -->
    <li class="w-[260px] flex-shrink-0 snap-start flex flex-col gap-2">
