---
import { ChevronDown, Layers, Ruler, Sparkles } from '@lucide/astro';
import type { DetailItem } from '../../data/product-info';

interface Props {
  items: DetailItem[];
}

const { items } = Astro.props;

const icons = {
  materials: Layers,
  size: Ruler,
  care: Sparkles,
};
---
<div class="mt-10 border-t border-[#D9CBA8]">
  {items.map((item) => {
    const Icon = icons[item.icon];
    return (
      <details name="product-details" class="group border-b border-[#D9CBA8]">
        <summary class="flex cursor-pointer list-none items-center gap-3 py-4 transition-colors hover:text-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink [&::-webkit-details-marker]:hidden">
          <Icon size={20} strokeWidth={1.5} />
          <span class="flex-1">{item.title}</span>
          <ChevronDown size={18} class="transition-transform duration-200 group-open:rotate-180" />
        </summary>
        <div class="space-y-3 pb-5 pl-8 leading-relaxed text-muted">
          {item.lines.map((line) => (
            <p>
              {line.label && <strong class="font-medium text-ink">{line.label}: </strong>}
              {line.text}
            </p>
          ))}
        </div>
      </details>
    );
  })}
</div>